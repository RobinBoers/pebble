<header>
  <h1><a href={~p"/#{@site}"}>pebble</a></h1>

  <div class="group">
    <select onchange="switch_site(this.value)">
      <option :for={site <- @sites} selected={site == @site}>{site}</option>
    </select>

    <.link href={"https://#{@site}"} target="_blank">View site →</.link>
    <.link href={"/#{@site}/identity"}>Settings</.link>
  </div>
</header>

<main>
  <%= if dbg(@conn.path_info) == [@site.hostname] do %>
    <header class="bar">
      <h2>Your home on the Web.</h2>
    </header>

    <p>Welcome to pebble, a simple but powerful tool to publish words on the Web.</p>

    <p><br></p>

    <h3>Quick actions</h3>

    <ul>
      <li>
        <.link href={~p"/#{@site}/templates"}>Pages</.link>
      </li>
      <li :for={schema <- Pebble.fetch_schemas(@site)}>
        <.link href={~p"/#{@site}/s/#{schema}"}>{schema.label}s</.link>
      </li>
      <li>
        <.link href={~p"/#{@site}/contacts"}>Contacts</.link>
      </li>
      <li>
        <.link href={~p"/#{@site}/menu"}>Menu</.link>
      </li>
    </ul>
  <% else %>
    {@inner_content}
  <% end %>
</main>